+        audio_item.type =
+            StreamItemType::kAudio;
+
+        audio_item.samples =
+            std::move(samples);
+
+        {
+          std::lock_guard<std::mutex> lock(
+              stream_queue_mutex);
+
+          stream_queue.push(
+              std::move(audio_item));
+        }
+
+        stream_queue_cv.notify_one();
+      };
